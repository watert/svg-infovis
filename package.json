{
  "name": "svg-infovis",
  "version": "0.1.0",
  "type": "module",
  "description": "几何内核: 圆角路径解算 / 几何谓词 / shapes descriptor / 字节确定的 SVG 序列化. 零运行时依赖, bun 直跑.",
  "exports": {
    ".": "./src/index.ts",
    "./geometry/vec": "./src/geometry/vec.ts",
    "./geometry/rounded-path": "./src/geometry/rounded-path.ts",
    "./geometry/predicates": "./src/geometry/predicates.ts",
    "./geometry/text-rows": "./src/geometry/text-rows.ts",
    "./geometry/inline-text": "./src/geometry/inline-text.ts",
    "./geometry/box": "./src/geometry/box.ts",
    "./geometry/grid": "./src/geometry/grid.ts",
    "./geometry/pack": "./src/geometry/pack.ts",
    "./geometry/place": "./src/geometry/place.ts",
    "./descriptor": "./src/descriptor.ts",
    "./serialize": "./src/serialize.ts",
    "./shapes/node": "./src/shapes/node.ts",
    "./shapes/edge": "./src/shapes/edge.ts",
    "./shapes/group": "./src/shapes/group.ts",
    "./shapes/text": "./src/shapes/text.ts",
    "./shapes/inline": "./src/shapes/inline.ts",
    "./shapes/grid-pattern": "./src/shapes/grid-pattern.ts",
    "./shapes/icon": "./src/shapes/icon.ts",
    "./shapes/embed": "./src/shapes/embed.ts",
    "./embed/svg-asset": "./src/embed/svg-asset.ts",
    "./icons/svg-parse": "./src/icons/svg-parse.ts",
    "./icons/path-data": "./src/icons/path-data.ts",
    "./icons/lucide": "./src/icons/lucide.ts",
    "./knives/route": "./src/knives/route.ts",
    "./knives/route-pair": "./src/knives/route-pair.ts",
    "./knives/route-cost": "./src/knives/route-cost.ts",
    "./knives/lanes": "./src/knives/lanes.ts",
    "./knives/constraints": "./src/knives/constraints.ts",
    "./knives/audit": "./src/knives/audit.ts",
    "./knives/measure": "./src/knives/measure.ts",
    "./knives/fit": "./src/knives/fit.ts",
    "./knives/codes": "./src/knives/codes.ts",
    "./knives/density": "./src/knives/density.ts",
    "./knives/describe": "./src/knives/describe.ts",
    "./knives/nudge": "./src/knives/nudge.ts",
    "./knives/cluster": "./src/knives/cluster.ts",
    "./scene": "./src/scene.ts",
    "./export": "./src/export.ts",
    "./theme": "./src/theme.ts",
    "./guard": "./src/guard.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "example": "bun run examples/start/basic.ts",
    "chain": "bun run examples/start/full-chain.ts",
    "manifest": "bun run examples/manifest.ts",
    "template": "bun run templates/sequence.ts",
    "ontology": "bun run examples/gallery/ontology-icons.ts",
    "pngs": "scripts/build-example-pngs.sh",
    "test": "bun test",
    "verify": "bun test && tsc --noEmit"
  },
  "license": "MIT",
  "bin": {
    "svginfo": "./scripts/cli.ts"
  },
  "dependencies": {
    "lucide-static": "^1.47.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "~5.9.3"
  }
}
